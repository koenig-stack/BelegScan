{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/belegscan/index.html" },
    { "source": "/belegscan", "destination": "/belegscan/index.html" },
    { "source": "/belegscan/:path*", "destination": "/belegscan/index.html" }
  ]
}
